# Copy to .env and choose private values. Never commit .env.
MYSQL_USER=single_store_team_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3309
API_HOST_PORT=18081
# Base64 of at least 32 random bytes, not a literal password.
JWT_SECRET=
# Optional first admin; provide BOTH or leave BOTH blank.
# Only works while the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
